<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
  入口界面（E 场景组装 · P2 无限存档位）：草地绿底 + 木牌菜单面板。
  配色/圆角/字号遵循《UI美术设计规范》§13 按钮、§14 主色表、§16 组件。
  布局契约（MainControllerMenuTest 依赖）：welcomeText / newSaveButton / slotList(fx:id)
  三者必须存在，且「新建存档」按钮文本保持「新建存档」。
-->
<VBox alignment="CENTER" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.fieldstory.farm.controller.MainController"
      style="-fx-background-color: #7FAE55;">
    <padding>
        <Insets bottom="32.0" left="32.0" right="32.0" top="32.0"/>
    </padding>

    <!-- 木牌菜单面板：UI背景 #FFF3DD + 木色 #8B5E3C 描边（规范 Panel：圆角12/边框2） -->
    <VBox alignment="TOP_CENTER" spacing="12.0" maxWidth="560.0"
          style="-fx-background-color: #FFF3DD;
                 -fx-background-radius: 18;
                 -fx-border-color: #8B5E3C;
                 -fx-border-radius: 18;
                 -fx-border-width: 3;
                 -fx-padding: 24 34 24 34;
                 -fx-effect: dropshadow(gaussian, rgba(73,53,38,0.35), 14, 0, 0, 5);">

        <Label text="田野故事农场"
               style="-fx-text-fill: #493526; -fx-font-size: 30; -fx-font-weight: bold;"/>
        <Label text="F I E L D   S T O R Y   F A R M"
               style="-fx-text-fill: #8B5E3C; -fx-font-size: 11;"/>

        <Region maxWidth="Infinity" prefHeight="2.0"
                style="-fx-background-color: #8B5E3C; -fx-opacity: 0.30;">
            <VBox.margin>
                <Insets bottom="2.0" top="6.0"/>
            </VBox.margin>
        </Region>

        <!-- 欢迎语 / 状态提示（setStatusMessage 复用此标签） -->
        <Label fx:id="welcomeText" wrapText="true" textAlignment="CENTER"
               style="-fx-text-fill: #493526; -fx-font-size: 14;"/>

        <Button fx:id="newSaveButton" text="新建存档" onAction="#onNewSaveButtonClick">
            <VBox.margin>
                <Insets bottom="4.0" top="4.0"/>
            </VBox.margin>
        </Button>

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <VBox.margin>
                <Insets top="8.0"/>
            </VBox.margin>
            <Label text="存档列表"
                   style="-fx-text-fill: #8B5E3C; -fx-font-size: 15; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="2.0"
                    style="-fx-background-color: #8B5E3C; -fx-opacity: 0.25;"/>
        </HBox>

        <!-- P2 无限存档位：存档行由 MainController#buildSlotRow 装配（空档也走此行） -->
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="200.0"
                    style="-fx-background-color: #FFF3DD;
                           -fx-background: #FFF3DD;
                           -fx-background-radius: 10;
                           -fx-border-color: #8B5E3C;
                           -fx-border-radius: 10;
                           -fx-border-width: 1;
                           -fx-padding: 6;">
            <VBox fx:id="slotList" alignment="TOP_LEFT" spacing="10.0"/>
        </ScrollPane>
    </VBox>
</VBox>
